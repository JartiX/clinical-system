# Скопируйте в .env — Docker Compose подхватит его автоматически
# Порт PostgreSQL на 127.0.0.1 хоста (для разработки и тестов)
DB_PORT=55440
# Пароль базы. На сервере обязательно задать свой — длинный случайный, например:
#   openssl rand -hex 24
# Применяется при первом создании базы. Если меняете — поправьте и DATABASE_URL в backend/.env.
POSTGRES_PASSWORD=clinical
# Порт веб-интерфейса на 127.0.0.1 хоста (на сервере на него проксирует nginx, см. deploy/nginx-host.conf)
WEB_PORT=5173
