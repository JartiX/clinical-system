# Скопируйте в backend/.env — настройки читает app/config.py, все значения необязательны
DATABASE_URL=postgresql+psycopg://clinical:clinical@localhost:55440/clinical
# Каталог справочников; по умолчанию content/ в корне репозитория
# CONTENT_DIR=../content
# Сервер Apache Tika для DOCX/PDF; без него используются встроенные читатели
# TIKA_URL=http://localhost:9998
DEFAULT_DATA_CLASS=synthetic
# Базовый IRI для постоянных идентификаторов при выгрузке в RDF
BASE_IRI=https://clinical-system.local/

# Тестовая БД: pytest берёт её только из переменной окружения, не из этого файла
# TEST_DATABASE_URL=postgresql+psycopg://clinical:clinical@localhost:55440/clinical_test
